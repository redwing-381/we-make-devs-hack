# Copy to .env and fill in. Never commit .env.

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# Pin after the smoke test passes (make smoke). 4.x line is the fallback.
FALKORDB_IMAGE=falkordb/falkordb:latest
# Default tenant graph. Others: whygraph_fresh (A/B demo), whygraph_sbx_<id> (sandboxes)
WHYGRAPH_GRAPH=whygraph_demo

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
# true = agents use only deterministic graph queries, no LLM narrative
GRAPH_ONLY=false

# --- Embeddings (Voyage via MongoDB Atlas -> AI Model APIs) ---
VOYAGE_API_KEY=
EMBED_MODEL=voyage-4-lite
EMBED_DIM=1024

# --- GitHub (fine-grained PAT scoped to the astro-mini repo only) ---
GITHUB_TOKEN=
GITHUB_REPO=your-org/astro-mini

# --- MCP / API auth (token our SDE agents send to /mcp) ---
WHYGRAPH_API_TOKEN=change-me
